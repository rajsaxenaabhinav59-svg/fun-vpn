{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fun-vpn",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "343789b9-c0f3-44fe-b48c-2d991af1fade","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "881f0c68c7f94008a9e0157b546cfe6b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
